{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="row text-left">

        <div class="col-md-4">
          <h5>About</h5>
          <p>
            <strong>Deeksha Varshney</strong><br>
            Assistant Professor<br>
            School of AI and Data Science<br>
            IIT Jodhpur
          </p>
        </div>

        <div class="col-md-4">
          <h5>Contact</h5>
          <p>
            Contact Deeksha via 
            <a href="mailto:deeksha@iitj.ac.in">email</a>
          </p>
        </div>

        <div class="col-md-4">
          <h5>Coordinates</h5>
          <p>
            Room no. 304-C<br>
            Instrumental Building<br>
            IIT Jodhpur
          </p>
        </div>

      </div>
    </div>

  </footer>
{% endif %}
